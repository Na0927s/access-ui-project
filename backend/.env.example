# AI (optional). Leave empty to run without AI — core analysis still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Comma-separated allowed origins for CORS (match the frontend dev port)
ALLOWED_ORIGINS=http://localhost:5176

# SQLite database location. Local default: ./colorlens.db
# Render 예시: sqlite:////var/data/colorlens.db (영구 디스크 /var/data 마운트 시)
DATABASE_URL=sqlite:///./colorlens.db

# 정적 파일(빌드된 프론트엔드) 서빙 디렉터리. 비워두면 정적 서빙 안 함(개발 모드).
# 배포 시 백엔드가 프론트를 함께 서빙하도록 빌드 결과 경로 지정 (예: ../frontend/dist)
STATIC_DIR=
